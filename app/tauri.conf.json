{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ViBrowse",
  "version": "1.2.5",
  "identifier": "com.vibrowse.browser",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis", "msi"],
    "category": "Network",
    "shortDescription": "Lightweight, low-RAM Chrome-compatible browser built with Rust",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"]
      }
    }
  }
}
